# =============================================================================
# GolfProCMS – Marketingwebsite
# -----------------------------------------------------------------------------
# Statische Seiten, deshalb ist hier wenig zu tun: saubere Adressen, eine
# eigene 404-Seite, Komprimierung und Cache-Regeln. Wer auf Netlify, Vercel
# oder GitHub Pages veroeffentlicht, braucht diese Datei nicht – dort gelten
# _headers/_redirects beziehungsweise die Voreinstellungen.
# =============================================================================

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Keine Umschreiberegeln: Die Verweise im HTML zeigen direkt auf die
# vorhandenen Dateien (produkt/index.html), deshalb ist nichts zu drehen.
# Die fruehere Weiterleitung auf die Ordnerform ging von einer Domain-Wurzel
# aus und haette die Website in einem Unterordner zerlegt.

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # HSTS nur ueber HTTPS setzen – sonst sperrt man eine Anlage ohne
  # Zertifikat fuer ein Jahr aus.
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Bilder, Schriften und Skripte aendern sich selten und werden bei einer
  # Aenderung ohnehin unter neuem Namen ausgeliefert.
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  # HTML bleibt kurz, damit eine Textaenderung sofort ankommt.
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
